dax$ echo $CXXFLAGS
-m64 -g -O0 -fno-builtin -mcpu=power9 -mno-isel -mno-crypto -mno-htm -mno-quad-memory-atomic -mfloat128-hardware -mfull-toc -mno-multiple -mupdate -mno-avoid-indexed-addresses -mregnames -mno-recip -fno-unsafe-math-optimizations -fno-fast-math -Wl,-rpath=/opt/bw/lib,--enable-new-dtags
