styx$ CC=/usr/bin/cc
styx$ export CC
styx$ CFLAGS='-m64 -O3'
styx$ export CFLAGS 
styx$ CPPFLAGS='-D_LARGEFILE64_SOURCE -D_XOPEN_SOURCE=600'
styx$ export CPPFLAGS 
styx$ 
styx$ $CC $CFLAGS $CPPFLAGS -I/opt/bw/include -c -o sysinfo.o ../sysinfo/sysinfo.c
styx$ $CC $CFLAGS $CPPFLAGS -I/opt/bw/include -c -o timediff.o ../time_and_date/timediff.c
