
On a typical AMD64 or x86_64 Linux boxen 

oberon$ CC=/opt/genunix/bin/gcc
oberon$ export CC

oberon$ CFLAGS='-std=iso9899:1999 -pedantic -pedantic-errors -g -O0 -m64 -fno-builtin -fno-fast-math -ffp-contract=off -fno-unsafe-math-optimizations -malign-double -march=k8 -mtune=k8 -mieee-fp -mhard-float -m128bit-long-double -mpreferred-stack-boundary=8 -Wl,-rpath=/opt/genunix/lib,-enable-new-dtags'
oberon$ export CFLAGS 

oberon$ CPPFLAGS='-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_XOPEN_SOURCE=600'
oberon$ export CPPFLAGS 
oberon$ 

$CC $CFLAGS $CPPFLAGS -c -o endian.o ../sysinfo/endian.c 

$CC $CFLAGS $CPPFLAGS -c -o sysinfo.o ../sysinfo/sysinfo.c 

$CC $CFLAGS $CPPFLAGS -I ../time_and_date    -c -o tdiff.o ../time_and_date/tdiff.c

$CC $CFLAGS $CPPFLAGS -I/opt/genunix/include -I ../time_and_date -c -o fgruenberger.o fgruenberger.c 



oberon$ 
oberon$ $CC $CFLAGS $CPPFLAGS -L/opt/genunix/lib -o fgruenberger fgruenberger.o sysinfo.o endian.o tdiff.o -lgmp -lm
oberon$ 

