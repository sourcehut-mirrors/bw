
On Solaris 11 sun4v hardware with the Oracle Studio 12.5 c99 tools :

$ echo $CC
/opt/developerstudio12.6/bin/c99

$ echo $CFLAGS
warf

$ echo $CPPFLAGS 
-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_XOPEN_SOURCE=600


$ $CC $CFLAGS $CPPFLAGS -c -o endian.o ../sysinfo/endian.c
$ $CC $CFLAGS $CPPFLAGS -c -o sysinfo.o ../sysinfo/sysinfo.c
$CC $CFLAGS $CPPFLAGS -I $HOME/local/include -c -o pair.o pair.c

 $CC $CFLAGS $CPPFLAGS -L $HOME/local/lib -R $HOME/local/lib  -o pair pair.o sysinfo.o endian.o -lgmp -lm

       NOTE: FreeBSD may want something special 

           $CC $CFLAGS $CPPFLAGS -L $HOME/local/lib -Wl,-rpath=/home/dclarke/local/lib,-enable-new-dtags -o pair pair.o sysinfo.o endian.o -lgmp -lm


The shell on Solaris just barfs are a really large string. So this hack :


neptune $ BIGNUM='90412595549414139695585839734542972800598084387417125706655138104526802551535778346908453488865881005438877237404'
neptune $ export BIGNUM
neptune $ BIGNUM=$BIGNUM'65467229857042846880561991348944234310869765344840513902872919742491377390672534'
neptune $ export BIGNUM
neptune $ BIGNUM=$BIGNUM'29506499876396186510562764635083152075130685909408356397510660161489040913053898577'
neptune $ export BIGNUM
neptune $ echo $BIGNUM
904125955494141396955858397345429728005980843874171257066551381045268025515357783469084534888658810054388772374046546722985704284688056199134894423431086976534484051390287291974249137739067253429506499876396186510562764635083152075130685909408356397510660161489040913053898577
neptune $ ./pair $BIGNUM
