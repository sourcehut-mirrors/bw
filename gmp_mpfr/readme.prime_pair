twin p and p+2



twin p and p+2





fully debuggable may be done on FreeBSD 

hydra$ 
hydra$ echo $CFLAGS 
-std=iso9899:1999 -m64 -O3 -fno-color-diagnostics -Wno-reserved-id-macro -Wno-missing-prototypes -Wno-padded -Wno-disabled-macro-expansion -Wno-sign-conversion -Wno-reserved-identifier -Wno-extra-semi-stmt -Wno-unsafe-buffer-usage
hydra$ CFLAGS='-std=iso9899:1999 -pedantic -pedantic-errors -g -O0 -fno-color-diagnostics -Wno-reserved-id-macro -Wno-missing-prototypes -Wno-padded -Wno-disabled-macro-expansion -Wno-sign-conversion -Wno-reserved-identifier -Wno-extra-semi-stmt -Wno-unsafe-buffer-usage'
hydra$ export CFLAGS 
hydra$ 
hydra$ $CC $CFLAGS $CPPFLAGS -c -o endian.o ../sysinfo/endian.c
hydra$ $CC $CFLAGS $CPPFLAGS -c -o sysinfo.o ../sysinfo/sysinfo.c
hydra$ 
hydra$ $CC $CFLAGS $CPPFLAGS -I/opt/bw/include -c -o pair.o pair.c
hydra$ 
hydra$ 
hydra$ $CC $CFLAGS $CPPFLAGS -L /opt/bw/lib -Wl,-rpath=/opt/bw/lib,-enable-new-dtags -o pair pair.o sysinfo.o endian.o -lgmp -lm
hydra$ 

