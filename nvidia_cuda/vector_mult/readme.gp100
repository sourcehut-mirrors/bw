

the largest array I can shoehorn into a GP100


esther$ $NVCC -x cu -ccbin $CXX -I../include -m64 \
> -gencode arch=compute_50,code=sm_50 -gencode arch=compute_60,code=sm_60 \
> -Wno-deprecated-gpu-targets --ftz=false --prec-div=true --prec-sqrt=true \
> -c -o vmultd.o vmultd.cu
esther$ 
esther$ $NVCC -ccbin $CXX -m64 \
> -gencode arch=compute_50,code=sm_50 -gencode arch=compute_60,code=sm_60 \
> -Wno-deprecated-gpu-targets --ftz=false --prec-div=true --prec-sqrt=true \
> -o vmultd vmultd.o -lgomp 
esther$ 
esther$ 
esther$ nvprof ./vmultd
