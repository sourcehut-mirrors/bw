
CC= /usr/bin/gcc

CFLAGS= -std=iso9899:1999 -pedantic -pedantic-errors \
	-m64 -g -O0 -fno-builtin -fno-fast-math \
	-mhard-float -mno-app-regs -mflat \
	-msoft-quad-float -mno-unaligned-doubles \
	-mno-faster-structs -mcpu=ultrasparc -mtune=ultrasparc \
	-mno-vis -mno-vis2 -mno-vis3 -mno-vis4 -mno-vis4b \
	-mno-cbcond -mno-fmaf -mno-fsmuld -mno-popc \
	-mno-subxc -mmemory-model=tso -fPIC

CPPFLAGS= -D_XOPEN_SOURCE=600 -D_LARGEFILE64_SOURCE \
	-D_FILE_OFFSET_BITS=64

include fbsd_common.mk

