These are merely used to check if a GCC compiler is working in
both 32-bit and 64-bit mode and can locate the required libs : 

$h uname -a
SunOS hubble 5.10 Generic_150400-67 sun4u sparc SUNW,SPARC-Enterprise

h$ nl -ba -nrz nothing.cpp 
000001  
000002  #include <iostream>
000003  
000004  /* This test rejects OSF 5.1 Compaq C++ in its default pre-standard iostream
000005     mode, since that mode puts cout in the global namespace, not "std".  */
000006  void someoutput (void) { std::cout << 123; }
000007  
000008  int main (void) { return 42; }
h$ 
h$ echo $CXX
/opt/bw/gcc9/bin/g++
h$ 
h$ $CXX --version
g++ (GENUNIX Wed Mar 26 20:41:00 GMT 2025) 9.5.0
Copyright (C) 2019 Free Software Foundation, Inc.
This is free software; see the source for copying conditions.  There is NO
warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.

h$ 
h$ echo $CXXFLAGS 
-g -O0 -mno-app-regs -mno-unaligned-doubles -fPIC
h$ 
h$ echo $CPPFLAGS 
-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
h$ 
h$ $CXX -m32 -mcpu=v8 $CXXFLAGS $CPPFLAGS -c -o nothing.o nothing.cpp
h$ 
h$ file nothing.o
nothing.o: ELF 32-bit MSB relocatable SPARC Version 1
h$ 
h$ od -Ax -t x1 -v -N 32 nothing.o
0000000 7f 45 4c 46 01 02 01 00 00 00 00 00 00 00 00 00
0000010 00 01 00 02 00 00 00 01 00 00 00 00 00 00 00 00
0000020
                  ^
                  |
       Note the CPU data in byte 0x13 claims 0x02

h$ 
h$ $CXX -m32 -mcpu=v8 $CXXFLAGS $CPPFLAGS -o nothing nothing.o
h$ 
h$ od -Ax -t x1 -v -N 32 nothing
0000000 7f 45 4c 46 01 02 01 06 01 00 00 00 00 00 00 00
0000010 00 02 00 12 00 00 00 01 00 01 08 f8 00 00 00 34
0000020

       Here the compiler and link stage have changed the
       CPU data to 0x12 == 18 decimal and we need to see
       https://cgit.freebsd.org/src/tree/sys/sys/elf_common.h

       Where is says #define EM_SPARC32PLUS 18 /* SPARC v8plus. */

h$ 
h$ ./nothing
ld.so.1: nothing: fatal: libstdc++.so.6: open failed: No such file or directory
Killed
h$ 


                 *********************************
                 * No RUNPATH or RPATH data seen *
                 *********************************

h$ elfdump -delv nothing | grep -E 'NEED|NAME|PATH'
       [0]  NEEDED            0x17a               libstdc++.so.6
       [1]  NEEDED            0x189               libm.so.2
       [2]  NEEDED            0x193               librt.so.1
       [3]  NEEDED            0x14e               libgcc_s.so.1
       [4]  NEEDED            0x164               libc.so.1
      [13]  VERNEED           0x107d8             
      [14]  VERNEEDNUM        0x2                 
h$ 


           NOTE : LD_LIBRARY_PATH is evil !
                  Only ever use in testing.

h$ LD_LIBRARY_PATH=/opt/bw/gcc9/lib ldd nothing
        libstdc++.so.6 =>        /opt/bw/gcc9/lib/libstdc++.so.6
        libm.so.2 =>     /lib/libm.so.2
        librt.so.1 =>    /lib/librt.so.1
        libgcc_s.so.1 =>         /opt/bw/gcc9/lib/libgcc_s.so.1
        libc.so.1 =>     /lib/libc.so.1
        libaio.so.1 =>   /lib/libaio.so.1
        libmd.so.1 =>    /lib/libmd.so.1
        /lib/libm/libm_hwcap1.so.2
        /platform/SUNW,SPARC-Enterprise/lib/libc_psr.so.1
h$ 

              Set a RUNPATH/RPATH option for the linker

h$ $CXX -m32 -mcpu=v8 $CXXFLAGS $CPPFLAGS -R/opt/bw/gcc9/lib/\$ISALIST -o nothing nothing.o
h$ 
h$ elfdump -delv nothing | grep -E 'NEED|NAME|PATH'
       [0]  NEEDED            0x17a               libstdc++.so.6
       [1]  NEEDED            0x189               libm.so.2
       [2]  NEEDED            0x193               librt.so.1
       [3]  NEEDED            0x14e               libgcc_s.so.1
       [4]  NEEDED            0x164               libc.so.1
       [7]  RUNPATH           0x19e               /opt/bw/gcc9/lib/$ISALIST
       [8]  RPATH             0x19e               /opt/bw/gcc9/lib/$ISALIST
      [15]  VERNEED           0x107f0             
      [16]  VERNEEDNUM        0x2                 
h$ 

h$
h$ ldd nothing
        libstdc++.so.6 =>        /opt/bw/gcc9/lib/sparcv8plus/libstdc++.so.6
        libm.so.2 =>     /lib/libm.so.2
        librt.so.1 =>    /lib/librt.so.1
        libgcc_s.so.1 =>         /opt/bw/gcc9/lib/sparcv8plus/libgcc_s.so.1
        libc.so.1 =>     /lib/libc.so.1
        libaio.so.1 =>   /lib/libaio.so.1
        libmd.so.1 =>    /lib/libmd.so.1
        /lib/libm/libm_hwcap1.so.2
        /platform/SUNW,SPARC-Enterprise/lib/libc_psr.so.1
h$

h$ isalist 
sparcv9+fmuladd sparcv9+vis2 sparcv9+vis sparcv9 sparcv8plus+vis2 sparcv8plus+vis sparcv8plus sparcv8 sparcv8-fsmuld sparcv7 sparc
h$ 
h$ ./nothing
h$ echo $?
42
h$ 
h$ od -Ax -t x1 -v -N 32 nothing
0000000 7f 45 4c 46 01 02 01 06 01 00 00 00 00 00 00 00
0000010 00 02 00 12 00 00 00 01 00 01 09 10 00 00 00 34
0000020
h$ 

       Note the CPU data in byte 0x13 claims 0x12 == 18


   ------------------ Now try 64-bit ---------------


h$ 
h$ $CXX -m64 -mcpu=v9 $CXXFLAGS $CPPFLAGS -c -o nothing.o nothing.cpp
h$ od -Ax -t x1 -v -N 32 nothing.o 
0000000 7f 45 4c 46 02 02 01 00 00 00 00 00 00 00 00 00
0000010 00 01 00 2b 00 00 00 01 00 00 00 00 00 00 00 00
0000020
h$ 
h$ $CXX -m64 -mcpu=v9 $CXXFLAGS $CPPFLAGS -R/opt/bw/gcc9/lib/\$ISALIST -o nothing nothing.o
h$ 
h$ elfdump -delv nothing | grep -E 'NEED|NAME|PATH'
       [0]  NEEDED            0x177               libstdc++.so.6
       [1]  NEEDED            0x186               libm.so.2
       [2]  NEEDED            0x190               librt.so.1
       [3]  NEEDED            0x14e               libgcc_s.so.1
       [4]  NEEDED            0x164               libc.so.1
       [7]  RUNPATH           0x19b               /opt/bw/gcc9/lib/$ISALIST
       [8]  RPATH             0x19b               /opt/bw/gcc9/lib/$ISALIST
      [15]  VERNEED           0x1000009a0         
      [16]  VERNEEDNUM        0x2                 
h$ 
h$ ldd nothing
        libstdc++.so.6 =>        /opt/bw/gcc9/lib/sparcv9/libstdc++.so.6
        libm.so.2 =>     /lib/64/libm.so.2
        librt.so.1 =>    /lib/64/librt.so.1
        libgcc_s.so.1 =>         /opt/bw/gcc9/lib/sparcv9/libgcc_s.so.1
        libc.so.1 =>     /lib/64/libc.so.1
        libaio.so.1 =>   /lib/64/libaio.so.1
        libmd.so.1 =>    /lib/64/libmd.so.1
        /lib/sparcv9/../libm/sparcv9/libm_hwcap1.so.2
        /platform/SUNW,SPARC-Enterprise/lib/sparcv9/libc_psr.so.1
h$ 
h$ ./nothing
h$ echo $?
42
h$ 
h$ od -Ax -t x1 -v -N 32 nothing
0000000 7f 45 4c 46 02 02 01 06 01 00 00 00 00 00 00 00
0000010 00 02 00 2b 00 00 00 01 00 00 00 01 00 00 0b 70
0000020
h$ 

         Note the RUNPATH/RPATH data is the same but the
         isalist feature provides lib location.

         Also the CPU type is now 0x2b == 43

         #define EM_SPARCV9 43 /* SPARC v9 64-bit. */


On this OS/machine one may set an env var and then it all just works
regardless of the 32-bit or 64-bit situation : 

h$ 
h$ LD_RUN_PATH=/opt/bw/gcc9/lib/\$ISALIST
h$ export LD_RUN_PATH
h$ 
h$ $CXX -m32 -mcpu=v8 $CXXFLAGS $CPPFLAGS -c -o nothing.o nothing.cpp
h$ $CXX -m32 -mcpu=v8 $CXXFLAGS $CPPFLAGS -o nothing nothing.o
h$ 
h$ ldd nothing
        libstdc++.so.6 =>        /opt/bw/gcc9/lib/sparcv8plus/libstdc++.so.6
        libm.so.2 =>     /lib/libm.so.2
        librt.so.1 =>    /lib/librt.so.1
        libgcc_s.so.1 =>         /opt/bw/gcc9/lib/sparcv8plus/libgcc_s.so.1
        libc.so.1 =>     /lib/libc.so.1
        libaio.so.1 =>   /lib/libaio.so.1
        libmd.so.1 =>    /lib/libmd.so.1
        /lib/libm/libm_hwcap1.so.2
        /platform/SUNW,SPARC-Enterprise/lib/libc_psr.so.1
h$ 
h$ elfdump -delv nothing | grep -E 'NEED|NAME|PATH'
       [0]  NEEDED            0x17a               libstdc++.so.6
       [1]  NEEDED            0x189               libm.so.2
       [2]  NEEDED            0x193               librt.so.1
       [3]  NEEDED            0x14e               libgcc_s.so.1
       [4]  NEEDED            0x164               libc.so.1
       [7]  RUNPATH           0x19e               /opt/bw/gcc9/lib/$ISALIST
