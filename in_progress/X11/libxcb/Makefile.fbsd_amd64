
CFLAGS= -std=iso9899:1999 -pedantic -pedantic-errors -m64 -g -O0 \
	-fno-fast-math -fno-builtin -fno-unsafe-math-optimizations \
	-fno-color-diagnostics -Wl,-rpath=/usr/local/lib,-enable-new-dtags \
	-Weverything -Wno-unsafe-buffer-usage -Wno-reserved-identifier \
	-Wno-documentation


CPPFLAGS= -D_XOPEN_SOURCE=600 -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
LIBS= -lxcb -lm -lpthread

LDIR= /usr/local/lib
IDIR= /usr/local/include

include common.mk

