
CC= /usr/bin/gcc

CFLAGS= -std=iso9899:1999 -pedantic -pedantic-errors \
	-m32 -g -O0 -fno-builtin -fno-fast-math -mhard-float \
	-mflat -msoft-quad-float \
	-mno-unaligned-doubles -mno-faster-structs \
	-mcpu=supersparc -mtune=supersparc \
	-mno-vis -mno-vis2 -mno-vis3 -mno-vis4 -mno-vis4b \
	-mno-cbcond -mno-fmaf -mno-fsmuld -mno-popc -mno-subxc \
	-mmemory-model=tso -fPIC \
	-Wl,-rpath=/usr/pkg/lib \
	-Wl,-rpath=/usr/X11R7/lib -Wl,-pie

CPPFLAGS= -D_XOPEN_SOURCE=600

IDIR=/usr/pkg/include -I/usr/X11R7/include
LDIR=/usr/pkg/lib -L/usr/X11R7/lib
LIBS=-lxcb -lrt -lm -lpthread

include common.mk

