enceladus$ 
enceladus$ echo $CFLAGS
-std=iso9899:1999 -pedantic -g -O0 -fno-builtin -m64 -mcpu=970 -mno-altivec -mno-isel -mno-vsx -mno-crypto -mno-htm -mno-quad-memory-atomic -mfull-toc -mno-multiple -mupdate -mno-avoid-indexed-addresses -mno-dlmzb -mno-bit-align -mno-strict-align -mbig -mregnames -mno-recip -fno-unsafe-math-optimizations -pedantic-errors -Wall
enceladus$ 
enceladus$ echo $CPPFLAGS 
-D_POSIX_PTHREAD_SEMANTICS -D_LARGEFILE64_SOURCE -D_XOPEN_SOURCE=600
enceladus$ 
enceladus$ $CC $CFLAGS $CPPFLAGS -o xcb_buff xcb_buff.c -lxcb
enceladus$ 
