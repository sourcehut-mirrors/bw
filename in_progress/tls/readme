For the sake of a comparison I will change the return value to 42 and
do the same test on a Solaris 10 SPARCv9 Fujitsu server using an entirely
different set of tools : 


hubble $ uname -a 
SunOS hubble 5.10 Generic_150400-67 sun4u sparc SUNW,SPARC-Enterprise
hubble $ 
hubble $ echo $CC
/opt/developerstudio12.6/bin/cc
hubble $ 
hubble $ $CC -V
cc: Studio 12.6 Sun C 5.15 SunOS_sparc 2017/05/30
hubble $ 
hubble $ cat t2.c


/* as seen at
 * https://bugs.freebsd.org/bugzilla/show_bug.cgi?id=235751
 */

struct s_t {
    int (*func)(int);
};

extern struct s_t __thread x;

int main(int argc, const char *argv[]) {
    return (*x.func)(argc+41);
}

hubble $ 
hubble $ echo $CFLAGS
-m64 -xarch=sparc -g -xO0 -mc -xs -errfmt=error -erroff=%none -errshort=full -errtags=yes -errwarn=%none -ftrap=%none -xbuiltin=%none -xildoff -xlibmieee -xstrconst -xcode=pic32 -xmemalign=8s -xnolibmil -xunroll=1 -xdepend -xregs=no%appl -xdebugformat=dwarf
hubble $ 
hubble $ echo $CPPFLAGS
-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_XOPEN_SOURCE=600 -D_POSIX_PTHREAD_SEMANTICS -D_TS_ERRNO
hubble $ 
hubble $ $CC $CFLAGS -G $CPPFLAGS -D_REENTRANT -o t1.so -h t1.so t1.c
hubble $ file t1.so
t1.so: ELF 64-bit MSB dynamic lib SPARCV9 Version 1, dynamically linked, not stripped
hubble $ 
hubble $ $CC $CFLAGS $CPPFLAGS -D_REENTRANT -o foo t2.c t1.so
hubble $ 
hubble $ elfdump -delv foo | grep -E 'NEED|NAME|PATH'
       [0]  NEEDED            0xe3                t1.so
       [1]  NEEDED            0xd0                libc.so.1
       [4]  RUNPATH           0xe9                /opt/bw/lib
       [5]  RPATH             0xe9                /opt/bw/lib
      [12]  VERNEED           0x1000007a8         
      [13]  VERNEEDNUM        0x1                 
hubble $ 
hubble $ ldd foo
        t1.so =>         (file not found)
        libc.so.1 =>     /lib/64/libc.so.1
        libm.so.2 =>     /lib/64/libm.so.2
        /lib/sparcv9/../libm/sparcv9/libm_hwcap1.so.2
        /platform/SUNW,SPARC-Enterprise/lib/sparcv9/libc_psr.so.1
hubble $ 
hubble $ LD_LIBRARY_PATH=`pwd` ./foo
hubble $ echo $?
42
hubble $ 

So that seems to work there.

Here is an IBM POWER9 server with the IBM XLC compiler : 

dax$ uname -a 
Linux dax 6.1.118-mrw1 #1 SMP Sun Nov 17 22:40:36 PST 2024 ppc64le GNU/Linux
dax$ 
dax$ CC=/opt/ibm/xlC/16.1.1/bin/xlc
dax$ export CC
dax$ 
dax$ CFLAGS='-qlanglvl=stdc99 -O0 -g'
dax$ export CFLAGS
dax$ 
dax$ CPPFLAGS='-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_XOPEN_SOURCE=600'
dax$ export CPPFLAGS
dax$ 
dax$ $CC $CFLAGS $CPPFLAGS -D_REENTRANT -shared -fPIC -o t1.so t1.c
dax$ file t1.so 
t1.so: ELF 64-bit LSB shared object, 64-bit PowerPC or cisco 7500, OpenPOWER ELF V2 ABI, version 1 (SYSV), dynamically linked, with debug_info, not stripped
dax$ 
dax$ $CC $CFLAGS $CPPFLAGS -D_REENTRANT -o foo t2.c t1.so 
dax$ ldd foo
        linux-vdso64.so.1 (0x00007fff83650000)
        t1.so => not found
        libgcc_s.so.1 => /lib/powerpc64le-linux-gnu/libgcc_s.so.1 (0x00007fff835e0000)
        libm.so.6 => /lib/powerpc64le-linux-gnu/libm.so.6 (0x00007fff834b0000)
        libc.so.6 => /lib/powerpc64le-linux-gnu/libc.so.6 (0x00007fff83200000)
        /lib64/ld64.so.2 (0x00007fff83660000)
dax$ 
dax$ LD_LIBRARY_PATH=`pwd` ./foo
dax$ echo $?
42
dax$ 


*************** MUSL LibC with Alpine Linux ***************

io$ uname -a 
Linux io.bw.genunix.com 6.12.8-0-lts #1-Alpine SMP PREEMPT_DYNAMIC 2025-01-02 12:14:41 x86_64 Linux
io$ 
io$ ldd --version
