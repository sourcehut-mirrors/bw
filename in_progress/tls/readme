Version 1.2.5
Dynamic Program Loader
Usage: /lib/ld-musl-x86_64.so.1 [options] [--] pathname
io$ 
io$ echo $CC
/usr/bin/gcc
io$ 
io$ $CC --version 
gcc (Alpine 14.2.0) 14.2.0
Copyright (C) 2024 Free Software Foundation, Inc.
This is free software; see the source for copying conditions.  There is NO
warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.

io$ 
io$ echo $CFLAGS 
-std=iso9899:1999 -pedantic -pedantic-errors -fno-builtin -g -O0 -march=k8 -mtune=k8
io$ 
io$ echo $CPPFLAGS 
-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_XOPEN_SOURCE=600
io$ 
io$ $CC $CFLAGS $CPPFLAGS -D_REENTRANT -shared -o t1.so -fPIC t1.c
io$ $CC $CFLAGS $CPPFLAGS -D_REENTRANT -o foo t2.c t1.so

io$ ldd foo
        /lib/ld-musl-x86_64.so.1 (0x7f06acd8b000)
Error loading shared library t1.so: No such file or directory (needed by foo)
        libc.musl-x86_64.so.1 => /lib/ld-musl-x86_64.so.1 (0x7f06acd8b000)
Error relocating foo: x: symbol not found
io$ 
io$ LD_LIBRARY_PATH=`pwd` ldd foo
        /lib/ld-musl-x86_64.so.1 (0x7fddd627d000)
        t1.so => /home/dclarke/pgm/bw/in_progress/tls/t1.so (0x7fddd626d000)
        libc.musl-x86_64.so.1 => /lib/ld-musl-x86_64.so.1 (0x7fddd627d000)
io$ 
io$ LD_LIBRARY_PATH=`pwd` ./foo
io$ echo $?
42
io$ 

