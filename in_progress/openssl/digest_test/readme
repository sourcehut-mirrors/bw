----------- trivial OpenSSL calls for hash digests -------------

On a FreeBSD 15.0-CURRENT x86_64 machine :

$ echo $CC
/usr/bin/cc

$ echo $CFLAGS 
-m64 -g -O0 -fno-fast-math -fno-builtin -fno-unsafe-math-optimizations -fno-color-diagnostics -Wl,-rpath=/opt/bw/lib

$ echo $CPPFLAGS
-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64

$ 
$ $CC $CFLAGS $CPPFLAGS -I/opt/bw/include -c -o trivial_dgst.o trivial_dgst.c
cc: warning: -Wl,-rpath=/opt/bw/lib: 'linker' input unused [-Wunused-command-line-argument]
$ $CC $CFLAGS $CPPFLAGS -L/opt/bw/lib -o trivial_dgst trivial_dgst.o -lcrypto
$ 
$ ldd trivial_dgst
trivial_dgst:
        libcrypto.so.3 => /opt/bw/lib/libcrypto.so.3 (0x301237347000)
        libc.so.7 => /lib/libc.so.7 (0x301238420000)
        libthr.so.3 => /lib/libthr.so.3 (0x301238f1a000)
        libsys.so.7 => /lib/libsys.so.7 (0x30123a15a000)
        [vdso] (0x301236947000)
$ 

On an IBM POWER9 server with Debian Linux and gcc 15.1.0 : 

$ CC=/opt/gcc-15.1.0/bin/gcc
$ export CC

$ CXX=/opt/gcc-15.1.0/bin/g++
$ export CXX

$ echo $CFLAGS
-std=iso9899:1999 -pedantic -pedantic-errors -g -O0 -m64 -fno-builtin -mcpu=power9 -mno-isel -mno-crypto -mno-htm -mregnames -fno-unsafe-math-optimizations -fno-fast-math -mfull-toc -mno-fp-in-toc -mno-sum-in-toc -ffp-contract=off -Wl,-rpath=/opt/bw/lib,--enable-new-dtags
$ 

$ CPPFLAGS='-D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D_XOPEN_SOURCE=600'
$ export CPPFLAGS 

$ $CC $CFLAGS $CPPFLAGS -I/opt/bw/include -c -o trivial_dgst.o trivial_dgst.c
$ $CC $CFLAGS $CPPFLAGS -L/opt/bw/lib -o trivial_dgst trivial_dgst.o -lcrypto

$ ldd trivial_dgst
        linux-vdso64.so.1 (0x00007fff81ea0000)
        libcrypto.so.3 => /opt/bw/lib/libcrypto.so.3 (0x00007fff81740000)
        libc.so.6 => /lib/powerpc64le-linux-gnu/libc.so.6 (0x00007fff81400000)
        /lib64/ld64.so.2 (0x00007fff81eb0000)

$ ./trivial_dgst SHA256
