CC=/usr/bin/cc
export CC
CFLAGS='-std=iso9899:1999 -pedantic -pedantic-errors -m64 -g -O0 -fno-fast-math -fno-builtin'
export CFLAGS
CPPFLAGS='-D_LARGEFILE64_SOURCE -D_XOPEN_SOURCE=600'
export CPPFLAGS

$CC $CFLAGS $CPPFLAGS -c -o sysinfo.o ../../sysinfo/sysinfo.c
$CC $CFLAGS $CPPFLAGS -c -o timediff.o ../../time_and_date/timediff.c 

$CC $CFLAGS $CPPFLAGS -c -o sched.o sched.c

$CC $CFLAGS $CPPFLAGS -o sched sched.o sysinfo.o timediff.o -lpthread
