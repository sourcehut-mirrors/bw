
CC= /usr/bin/gcc

CFLAGS= -std=iso9899:1999 -m64 -O3 -mhard-float \
	-mno-app-regs -mno-faster-structs \
	-mcpu=ultrasparc -mtune=ultrasparc \
	-mno-vis -mno-vis2 -mno-vis3 -mno-vis4 -mno-vis4b \
	-mmemory-model=tso -fPIC \
	-Wl,-rpath=/usr/pkg/lib \
	-Wl,-rpath=/usr/X11R7/lib -Wl,-pie

CPPFLAGS= -D_XOPEN_SOURCE=600 -D_LARGEFILE64_SOURCE \
	-D_FILE_OFFSET_BITS=64

IDIR=/usr/pkg/include -I/usr/X11R7/include
LDIR=/usr/pkg/lib -L/usr/X11R7/lib
LIBS=-lX11 -lrt -lm -lpthread

include common.mk

