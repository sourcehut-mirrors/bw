
CFLAGS= -std=iso9899:1999 -pedantic -pedantic-errors -Weverything \
	-Wno-reserved-id-macro -Wno-missing-prototypes -m32 -g -O0 \
	-fno-fast-math -fno-builtin -Wno-reserved-identifier \
	-fno-color-diagnostics \
	-Wno-unsafe-buffer-usage


CPPFLAGS?=	-D_LARGEFILE64_SOURCE -D_XOPEN_SOURCE=600 \
		-D_FILE_OFFSET_BITS=64

include common.mk

