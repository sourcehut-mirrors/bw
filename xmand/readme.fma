    764b:   00
    764c:   c5 f3 2a c1             vcvtsi2sd xmm0,xmm1,ecx
    7650:   c5 f3 2a d2             vcvtsi2sd xmm2,xmm1,edx
    7654:   c5 e9 14 d0             vunpcklpd xmm2,xmm2,xmm0
    7658:   c5 f3 2a c7             vcvtsi2sd xmm0,xmm1,edi
    765c:   c5 f3 2a ce             vcvtsi2sd xmm1,xmm1,esi
    7660:   c5 f9 14 c1             vunpcklpd xmm0,xmm0,xmm1
    7664:   c5 f9 28 0d d4 30 00    vmovapd xmm1,XMMWORD PTR [rip+0x30d4]        # a740 <_IO_stdin_used+0x1740>
    766b:   00
    766c:   c5 f9 5e c2             vdivpd xmm0,xmm0,xmm2
    7670:   c5 f1 5e d2             vdivpd xmm2,xmm1,xmm2
    7674:   c4 e2 e1 98 05 a3 30    vfmadd132pd xmm0,xmm3,XMMWORD PTR [rip+0x30a3]        # a720 <_IO_stdin_used+0x1720>
    767b:   00 00
    767d:   c5 e9 58 c0             vaddpd xmm0,xmm2,xmm0
