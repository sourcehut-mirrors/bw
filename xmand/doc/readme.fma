Also the fp_vbox() does not employ FMA at all : 

!
! SUBROUTINE fp_vbox
!
! OFFSET    SOURCE LINE LABEL   INSTRUCTION

                        .global fp_vbox
                       

                        fp_vbox:
                       
! predecessor blocks: fp_vbox

                        .L900000110:
/* 000000         49 */         save    %sp,-192,%sp

!   51                !    /* try to reduce the number of floating point operations */
!   52                !    int numerator = 2 * Vr * VBOX_SAMPLE_REAL + 2 * Sr - real_range + 1;
!   53                !    cplex->r = numerator / ( 1.0 * real_range );
!   55                !    numerator = 2 * Vj * VBOX_SAMPLE_IMAG + 2 * Sj - imag_range + 1;
!   56                !    cplex->j = numerator / ( 1.0 * imag_range );

